{
  "name": "agenttrace",
  "version": "0.1.0",
  "description": "Local CLI utilities for the AgentTrace project",
  "type": "module",
  "bin": {
    "agenttrace": "dist/bin.js"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "tsc --noEmit && tsup bin.ts --format esm --target node20 --out-dir dist --clean --dts false --sourcemap false",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md,yml,yaml}\""
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
